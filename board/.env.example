# EverLink decision board — environment (Vercel + Neon)
# Copy to .env.local for dev; NEVER commit a real .env. Placeholders only here.

# EverLink's OWN Postgres (the same DB the Python agent writes decisions/audit to).
# On Vercel, the Neon Marketplace integration usually sets DATABASE_URL for you;
# the board reads EVERLINK_DATABASE_URL first, then falls back to DATABASE_URL.
# This MUST NOT be a source site's production instance (the board only ever writes
# decision status transitions; it never touches source content).
EVERLINK_DATABASE_URL=postgresql://user:pass@host-pooler/everlink?sslmode=require

# Optional defense-in-depth: comma-separated host fragments the board refuses to
# write to (mirrors the Python deny-list). Leave blank in dev.
EVERLINK_FORBIDDEN_HOSTS=

# Optional: set to "1" to serve the board as a READ-ONLY public view (hides all
# approve/reject controls). Used for the live demo link so the audience can look
# but not touch.
NEXT_PUBLIC_BOARD_READONLY=
