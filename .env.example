# ── EverLink environment template ─────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# All DB access is READ-ONLY; the agent sets `default_transaction_read_only=on`
# after connecting. Connection strings are resolved at runtime from the source
# projects' own .env files during Phase A export — they are listed here only to
# document what the running agent needs, not to be pasted with real secrets.

# --- AWS / Bedrock (Strands Agents SDK) ---
AWS_REGION=us-east-1
AWS_PROFILE=
# Bedrock model id used by BedrockModel (see spec §6). Example:
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# Auth is picked up from the standard AWS credential chain (SSO / env / profile).
# Do NOT hardcode long-lived keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Read-only source databases (Phase A export only) ---
# Point these at the three production sites' read replicas / poolers.
AETHELGEM_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require
SANDCART_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require
HOTDEALS_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require

# scripts/export_slots.py resolves each site's DATABASE_URL at runtime from that
# project's own .env file. Set these to the absolute .env paths on YOUR machine
# (they are intentionally not hardcoded in the repo). Leave blank to skip a site.
EVERLINK_AEG_ENV=
EVERLINK_SANDCART_ENV=
EVERLINK_HOTDEALS_ENV=
# Set to 1 to force re-export even when data/slots_<site>.csv already exists.
EVERLINK_FORCE=

# --- EverLink own store (spec §5: link_slots / slot_checks / decisions / ...) ---
# MUST be EverLink's own database — never a source site's production instance.
EVERLINK_DATABASE_URL=postgresql://user:pass@host-pooler/everlink?sslmode=require
# Extra write-deny-list (comma-separated host fragments). EverLink also derives
# this automatically from the three source-site URLs above, so this is optional.
EVERLINK_FORBIDDEN_HOSTS=

# --- Surfacing / notification (spec §7 push-to-surface) ---
# Email via Resend's REST API. All three (key + from + recipient) must be set for
# the email channel to be ACTIVE; otherwise delivery is honestly reported as
# "skipped" and nothing is faked. Recipients may be comma-separated.
RESEND_API_KEY=
RESEND_FROM=EverLink <brief@yourdomain.com>
EVERLINK_NOTIFY_EMAIL=
# Telegram bot push (optional second channel). Chat ids may be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Absolute URL of the pd3 approval board. Linked from every notification so a card
# opens straight into its review page (e.g. https://everlink-board.vercel.app).
EVERLINK_BOARD_URL=

# --- Nightly cron (scripts/nightly.py — the full-chain autonomous loop) ---
# Comma-separated scan targets for the nightly run. Defaults to the three first-party
# sites (all scanned READ-ONLY; write-back is aethelgem only, per the guardrail).
EVERLINK_NIGHTLY_SITES=aethelgem,sandcart,hotdeals
# Judge backend the nightly scan uses: bedrock (real LLM, default), stub (offline fixture),
# or none (detection only — no AWS creds, produces zero proposals).
EVERLINK_JUDGE=bedrock
# 3-letter weekday the weekly report folds into the nightly cron (single service, one
# schedule). Set EVERLINK_WEEKLY_DAY=mon so Monday's 03:00 run also sends the digest.
EVERLINK_WEEKLY_DAY=mon

# --- Fixture / demo server ---
FIXTURE_PORT=8787
