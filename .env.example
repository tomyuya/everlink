# ── EverLink environment template ─────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# All DB access is READ-ONLY; the agent sets `default_transaction_read_only=on`
# after connecting. Connection strings are resolved at runtime from the source
# projects' own .env files during Phase A export — they are listed here only to
# document what the running agent needs, not to be pasted with real secrets.

# --- AWS / Bedrock (Strands Agents SDK) ---
AWS_REGION=us-east-1
# Bedrock model id used by BedrockModel (see spec §6). Defaults to the value in
# everlink/llm.py (DEFAULT_MODEL_ID); override here to move Claude variants or
# cross-region inference profiles with zero code change.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Auth is picked up from the standard AWS credential chain (SSO / shared
# credentials file / env). Do NOT hardcode long-lived keys here.
#
# KEEP THE NEXT THREE COMMENTED OUT unless you really mean to override the chain:
# an *empty* `AWS_PROFILE=` / `AWS_ACCESS_KEY_ID=` still sets the env var, and
# botocore then prefers the empty value over ~/.aws/credentials — the Bedrock
# Mantle token mint fails with "Failed to mint Bedrock Mantle bearer token ...
# Verify your AWS credentials" even though `aws sts get-caller-identity` works.
#AWS_PROFILE=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Bedrock Mantle gateway (the deployed Judge path; see everlink/llm.py) ---
# Mantle serves OpenAI-compatible Chat Completions and bypasses the account-level
# Bedrock allowlist gate that blocks direct SigV4 Claude on some accounts.
# IAM path (production/cron): set nothing — tokens are minted from the AWS chain.
# Local/demo path: mint a key in the console and set it here; it is used verbatim
# as the OpenAI client api_key against https://bedrock-mantle.<region>.api.aws/v1.
#BEDROCK_MANTLE_API_KEY=
#BEDROCK_MANTLE_MODEL_ID=qwen.qwen3-next-80b-a3b-instruct
#BEDROCK_MANTLE_REASONING=

# --- Read-only source databases (Phase A export only) ---
# Point these at the three production sites' read replicas / poolers.
AETHELGEM_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require
SANDCART_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require
HOTDEALS_DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require

# --- Public origin per first-party site (link absolutization) ---
# Some source databases store INTERNAL links as bare relative paths (e.g.
# /products/...). EverLink absolutizes them against the site's PUBLIC ORIGIN at
# ingestion so probes hit the real store instead of failing the SSRF scheme check.
# Set YOUR OWN domain per site; symmetric with <SITE>_DATABASE_URL above. A site
# whose links are already absolute (e.g. Amazon affiliate URLs) needs no origin.
# NOTHING is hardcoded in the repo — an unset origin leaves relative URLs as-is,
# so a missing config surfaces honestly instead of a fabricated domain.
SANDCART_PUBLIC_ORIGIN=https://your-store.example.com
# AETHELGEM_PUBLIC_ORIGIN=
# HOTDEALS_PUBLIC_ORIGIN=

# scripts/export_slots.py resolves each site's DATABASE_URL at runtime from that
# project's own .env file. Set these to the absolute .env paths on YOUR machine
# (they are intentionally not hardcoded in the repo). Leave blank to skip a site.
EVERLINK_AEG_ENV=
EVERLINK_SANDCART_ENV=
EVERLINK_HOTDEALS_ENV=
# Set to 1 to force re-export even when data/slots_<site>.csv already exists.
EVERLINK_FORCE=

# --- EverLink own store (spec §5: link_slots / slot_checks / decisions / ...) ---
# MUST be EverLink's own database — never a source site's production instance.
EVERLINK_DATABASE_URL=postgresql://user:pass@host-pooler/everlink?sslmode=require
# Extra write-deny-list (comma-separated host fragments). EverLink also derives
# this automatically from the three source-site URLs above, so this is optional.
EVERLINK_FORBIDDEN_HOSTS=

# --- Surfacing / notification (spec §7 push-to-surface) ---
# Email via Resend's REST API. All three (key + from + recipient) must be set for
# the email channel to be ACTIVE; otherwise delivery is honestly reported as
# "skipped" and nothing is faked. Recipients may be comma-separated.
RESEND_API_KEY=
RESEND_FROM=EverLink <brief@yourdomain.com>
EVERLINK_NOTIFY_EMAIL=
# Telegram bot push (optional second channel). Chat ids may be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Absolute URL of the approval board's ROOT (e.g. https://everlink-board.vercel.app).
# Notifications deep-link from it: the morning brief and the low-risk batch list point at
# /inbox, a single-card push at /decision/<id>, the weekly digest at /report. Set the root,
# not a page — a URL that already carries a path is used as-is (sub-path deployments).
EVERLINK_BOARD_URL=

# --- Nightly cron (scripts/nightly.py — the full-chain autonomous loop) ---
# Comma-separated scan targets for the nightly run. Defaults to the three first-party
# sites (all scanned READ-ONLY; write-back is aethelgem only, per the guardrail).
EVERLINK_NIGHTLY_SITES=aethelgem,sandcart,hotdeals
# Judge backend the nightly scan uses: mantle (real LLM via Bedrock Mantle, DEFAULT),
# bedrock (direct SigV4 Claude, account-allowlist gated), stub (offline fixture), or none
# (detection only - no AWS creds, produces zero proposals).
EVERLINK_JUDGE=mantle
# 3-letter weekday the weekly report folds into the nightly cron (single service, one
# schedule). Set EVERLINK_WEEKLY_DAY=mon so Monday's 03:00 run also sends the digest.
EVERLINK_WEEKLY_DAY=mon

# --- Fixture / demo server ---
FIXTURE_PORT=8787
# Set to 1 to disable the SSRF guard's private-IP blocking (allows localhost
# requests). The fixture server sets this automatically via make_server(); do NOT
# set it in production. Left blank/unset = full SSRF protection active.
EVERLINK_ALLOW_LOCALNET=
