# --- secrets: NEVER commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
aws_credentials*
credentials.json

# --- exported data snapshots ---
# slots_*.csv = the first-party Scanner's READ-ONLY Phase-A input. No secrets/PII
# (just public url/anchor/slot_type/protected flags); the production nightly cron
# bakes them into the PRIVATE image (Dockerfile COPYs data/), so they ARE committed.
# Raw *.jsonl dumps stay local-only.
data/*.csv
!data/slots_*.csv
data/*.jsonl
!data/slots_summary.json
!data/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- agent runtime / eval artifacts ---
runs/
*.sqlite
*.db
otel-*.json

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- local scratch (kept out of the public repo) ---
_*out.txt
_commit_msg.txt
probe_*.py
discover_schema.py
scripts/__pycache__/
.vercel
